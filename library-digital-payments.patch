+/*
+|--------------------------------------------------------------------------
+| DIGITAL LIBRARY CHECKOUT (buy a priced digital resource)
+|--------------------------------------------------------------------------
+|
+| A resource the Digital Librarian has marked is_purchasable with a
+| price isn't free to download like the rest of the digital collection
+| — the reader pays via Chapa first. Browsing (digital/digital.show
+| above) stays fully public; only starting checkout requires being
+| logged in, same reasoning as the Ebook storefront.
+|
+*/
+
+Route::prefix('library/catalog/digital/{resource}/checkout')
+    ->as('library.public.digital.')
+    ->middleware('auth')
+    ->group(function () {
+
+        Route::get('/', [LibraryDigitalOrderController::class, 'show'])->name('checkout');
+
+        Route::post('/', [LibraryDigitalOrderController::class, 'store'])->name('checkout.process');
+
+        Route::get('/return', [LibraryDigitalOrderController::class, 'returnFromChapa'])->name('checkout.return');
+    });
+
+Route::post('library/orders/chapa/webhook', [LibraryDigitalOrderController::class, 'webhook'])
+    ->name('library.orders.chapa.webhook');
